# Anthropic API key (loop of decision + finding generation).
ANTHROPIC_API_KEY=

# Models used by the loop. Confirm current identifiers in Anthropic's docs
# before changing the default in config.py.
AUDIT_AGENT_MODEL_DECISION=claude-sonnet-5
AUDIT_AGENT_MODEL_CHEAP=claude-haiku-4-5-20251001

# PageSpeed Insights (perf_probe). Free, quota-limited.
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_KEY=

# Wordfence vulnerability feed (vuln_check). Only needed to download the
# feed via scripts/download_wordfence_feed.py; not required to run audits.
# Generate a key at wordfence.com > account > Integrations.
WORDFENCE_API_KEY=
WORDFENCE_FEED_PATH=wordfence_feed.json

# Guardrails (safe defaults; override only if you know why).
AUDIT_AGENT_MAX_ITERATIONS=12
AUDIT_AGENT_MAX_COST_USD=0.50
AUDIT_AGENT_MAX_TOOL_CALLS=30
AUDIT_AGENT_TIMEOUT_GLOBAL_S=180
AUDIT_AGENT_TIMEOUT_TOOL_S=15
